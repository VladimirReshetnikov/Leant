Cabal-Version: 3.0
Name:          leant
Version:       0.1.0
Synopsis:      A Djex-based synthesis REPL for Lean 4
Description:
  An interactive read-eval-print loop for Lean 4: expressions evaluate,
  declarations extend the session, and colon-commands provide type queries,
  documentation, search, interactive proving, and backend-verified term
  synthesis (via the vendored Djex library). Talks directly to the
  leanprover-community/repl backend (JSON over stdin/stdout), with a
  Haskeline front-end.
-- MIT-0, with an Unlicense public-domain dedication where that is
-- legally effective; both texts are in LICENSE.
License:       MIT-0
License-file:  LICENSE
Author:        Vladimir Reshetnikov
Maintainer:    Vladimir Reshetnikov
Copyright:     2026 Leant Contributors
Homepage:      https://github.com/VladimirReshetnikov/Leant
Bug-Reports:   https://github.com/VladimirReshetnikov/Leant/issues
Category:      Development
Build-Type:    Simple

Source-Repository head
  Type:     git
  Location: https://github.com/VladimirReshetnikov/Leant

Executable leant
  Default-Language: Haskell2010
  Hs-Source-Dirs:   src
  Main-Is:          Main.hs
  Other-Modules:
    Leant.Backend
    Leant.Builtins
    Leant.Classify
    Leant.Format
    Leant.Json
    Leant.Json.Bounded
    Leant.Session.Replay
    Leant.Session.Snapshot
    Leant.Synth.Engine
    Leant.Synth.Fragment
    Leant.Synth.Length.Adapter
    Leant.Synth.Length.Configuration
    Leant.Synth.Length.Configuration.File
    Leant.Synth.Length.Configuration.File.Acquire
    Leant.Synth.Length.Contract
    Leant.Synth.Length.Ranking
    Leant.Synth.Observability
    Leant.Synth.ProviderCache
    Leant.Synth.Replay
    Leant.Synth.Render
    Leant.Synth.Verification
  Ghc-Options:
    -Wall
    -Wcompat
    -Wincomplete-uni-patterns
    -threaded
  Build-Depends:
    base       >= 4.19 && < 5,
    bytestring >= 0.11 && < 0.13,
    containers >= 0.6  && < 0.9,
    deepseq    >= 1.4  && < 1.6,
    directory  >= 1.3  && < 1.4,
    djex       >= 2026.7.17 && < 2027,
    filepath   >= 1.4  && < 1.6,
    haskeline  >= 0.8  && < 0.9,
    process    >= 1.6  && < 1.7,
    text       >= 2.0  && < 2.2,
    time       >= 1.12 && < 1.15
  if os(windows)
    Build-Depends: Win32 >= 2.13 && < 2.15
  else
    Build-Depends: unix >= 2.8 && < 2.9

Test-Suite leant-synth-tests
  Type:             exitcode-stdio-1.0
  Default-Language: Haskell2010
  Hs-Source-Dirs:   test-unit, src
  Main-Is:          Spec.hs
  Other-Modules:
    Leant.Backend
    Leant.Synth.Engine
    Leant.Synth.Fragment
    Leant.Synth.Length.Adapter
    Leant.Synth.Length.Configuration
    Leant.Synth.Length.Configuration.File
    Leant.Synth.Length.Configuration.File.Acquire
    Leant.Synth.Length.Contract
    Leant.Synth.Length.Ranking
    Leant.Synth.Observability
    Leant.Synth.ProviderCache
    Leant.Synth.Replay
    Leant.Synth.Render
    Leant.Synth.Verification
    Leant.Json
    Leant.Json.Bounded
    Leant.Session.Replay
    Leant.Session.Snapshot
  Ghc-Options:
    -Wall
    -Wcompat
    -Wincomplete-uni-patterns
  Build-Tool-Depends:
    djex:djex-fake-z3
  Build-Depends:
    base        >= 4.19  && < 5,
    bytestring  >= 0.11  && < 0.13,
    containers  >= 0.6   && < 0.9,
    deepseq     >= 1.4   && < 1.6,
    directory   >= 1.3   && < 1.4,
    djex        >= 2026.7.17 && < 2027,
    filepath    >= 1.4   && < 1.6,
    process     >= 1.6   && < 1.7,
    text        >= 2.0   && < 2.2,
    tasty       >= 1.4.2 && < 2,
    tasty-hunit >= 0.10  && < 1
  if !os(windows)
    Build-Depends: unix >= 2.8 && < 2.9
