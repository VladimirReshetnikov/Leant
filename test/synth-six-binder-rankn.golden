λ> namespace SixBinder
λ> axiom Six : Type → Type → Type → Type → Type → Type → Type
λ> axiom Token : Type
λ> class Choice (one two three four five six : Type 1) : Prop where witness : True
λ> instance : Choice (∀ A : Type, A → A) (∀ B : Type, B → B → B) (∀ C : Type, C → C → C → C) (∀ D : Type, D → D → D → D → D) (∀ E : Type, E → E → E → E → E → E) (∀ F : Type, F → F → F → F → F → F → F) := ⟨True.intro⟩
