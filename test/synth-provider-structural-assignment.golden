…>   Prod LeftType RightType → Sum LeftType RightType → Token
…>
λ> end StructuralDirect
λ>
λ> namespace StructuralContext
λ>
λ> axiom Token : Type
λ> axiom Fixed : Type
λ>
λ> class Binary (F : Type → Type → Type) : Prop where
…>   witness : True
…>
λ> class Unary (G : Type → Type) : Prop where
…>   witness : True
…>
λ> abbrev Selected :=
…>   {a : Type} → [Binary Prod] → [Unary (Sum Fixed)] → a → a
…>
λ> class Pick (selected : Type 1) : Prop where
…>   witness : True
…>
λ> instance : Pick Selected := ⟨True.intro⟩
λ>
λ> axiom choose {selected : Type 1} [Pick selected] : Token
λ>
λ> end StructuralContext
