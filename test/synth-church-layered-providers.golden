λ> :set synth-window 1
synth window: 1
note: each lane verifies 1 groups, clamped by synth-window 1
λ> :set synth-verify 1
synth verify: 1
λ> :set synth-shown 1
synth shown: 1
λ> :set synth-engine djinn
synth engine: djinn
