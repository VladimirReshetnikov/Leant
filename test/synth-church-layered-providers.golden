Leant (Haskell) - a GHCi-style REPL for Lean 4.  Type :help for help, :quit to exit.
λ> namespace ChurchLayered
λ> axiom Seed : Type
λ> axiom seed : Seed
λ> axiom G2 : Type 1 → Type 1 → Type 1
λ> axiom G3 : Type 1 → Type 1 → Type 1 → Type 1
λ> axiom maker2 : Seed → ∀ a : Type 1, a → Seed → ∀ b : Type 1, b → G2 a b
λ> axiom maker3 : Seed → ∀ a b : Type 1, a → b → Seed → ∀ c : Type 1, c → G3 a b c
λ> end ChurchLayered
λ> :set synth-library off
synth library: off
λ> :set synth-classical off
synth classical: off
λ> :set synth-providers on
synth providers: on
λ> :set synth-steps 4096
