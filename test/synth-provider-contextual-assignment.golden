Leant (Haskell) - a GHCi-style REPL for Lean 4.  Type :help for help, :quit to exit.
λ> namespace ContextualOnly
λ>
λ> axiom Token : Type
λ>
λ> class Pick (a : Type 1) : Prop where
…>   witness : True
…>
λ> abbrev Choice := {a : Type} → [Inhabited a] → a → a
λ>
λ> instance : Pick Choice := ⟨True.intro⟩
λ>
λ> axiom chosen {a : Type 1} [Pick a] : Token
λ>
λ> end ContextualOnly
λ>
λ> namespace HigherContext
λ>
λ> axiom Token : Type
λ>
λ> class Mark (f : Type → Type) : Prop where
…>   witness : True
…>
λ> abbrev Choice := {a : Type} → [Mark List] → a → a
λ>
λ> class Pick (a : Type 1) : Prop where
…>   witness : True
…>
λ> instance : Pick Choice := ⟨True.intro⟩
λ>
λ> axiom chosen {a : Type 1} [Pick a] : Token
λ>
λ> end HigherContext
λ>
λ> namespace DependentContext
λ>
λ> class Dep where
…>   T : Type
…>
λ> abbrev Choice := [d : Dep] → d.T
λ>
λ> class Pick (a : Type 1) : Prop where
…>   witness : True
…>
λ> instance : Pick Choice := ⟨True.intro⟩
λ>
λ> axiom Token : Type
λ>
λ> axiom chosen {a : Type 1} [Pick a] : Token
λ>
λ> end DependentContext
λ>
