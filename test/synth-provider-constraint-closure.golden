λ> namespace ClosureControl
λ> axiom Token : Type
λ> private abbrev P1 := ∀ x : Type, x → x
λ> private abbrev P2 := ∀ x : Type, x → x → x
λ> private abbrev P3 := ∀ x : Type, x → x → x → x
λ> private abbrev P4 := ∀ x : Type, x → x → x → x → x
λ> private abbrev GoodA := ∀ x : Type, (x → x) → x → x
λ> private abbrev GoodB := ∀ x : Type, (x → x → x) → x → x
λ> private class PairChoice (a b : Type 1) : Prop where witness : True
λ> private class RequiredChoice (a b : Type 1) : Prop where witness : True
λ> private instance (priority := 1) : PairChoice GoodA GoodB := ⟨True.intro⟩
λ> private instance : PairChoice P1 P1 := ⟨True.intro⟩
λ> private instance : PairChoice P1 P2 := ⟨True.intro⟩
λ> private instance : PairChoice P1 P3 := ⟨True.intro⟩
λ> private instance : PairChoice P1 P4 := ⟨True.intro⟩
λ> private instance : PairChoice P2 P1 := ⟨True.intro⟩
λ> private instance : PairChoice P2 P2 := ⟨True.intro⟩
λ> private instance : PairChoice P2 P3 := ⟨True.intro⟩
λ> private instance : PairChoice P2 P4 := ⟨True.intro⟩
λ> private instance : PairChoice P3 P1 := ⟨True.intro⟩
λ> private instance : PairChoice P3 P2 := ⟨True.intro⟩
λ> private instance : PairChoice P3 P3 := ⟨True.intro⟩
λ> private instance : PairChoice P3 P4 := ⟨True.intro⟩
λ> private instance : PairChoice P4 P1 := ⟨True.intro⟩
λ> private instance : PairChoice P4 P2 := ⟨True.intro⟩
λ> private instance : PairChoice P4 P3 := ⟨True.intro⟩
λ> private instance : PairChoice P4 P4 := ⟨True.intro⟩
λ> private instance : RequiredChoice GoodA GoodB := ⟨True.intro⟩
λ> axiom global {a b : Type 1} [PairChoice a b] [RequiredChoice a b] : Token
λ> end ClosureControl
