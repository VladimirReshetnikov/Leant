λ> namespace ClosureGood
λ> axiom Token : Type
λ> private class LeftChoice (a : Type 1) : Prop where witness : True
λ> private class RightChoice (b : Type 1) : Prop where witness : True
λ> private instance : LeftChoice (∀ x : Type, x → x) := ⟨True.intro⟩
λ> private instance : RightChoice (∀ x : Type, x → x → x) := ⟨True.intro⟩
λ> axiom global {a b : Type 1} [LeftChoice a] [RightChoice b] : Token
λ> end ClosureGood
