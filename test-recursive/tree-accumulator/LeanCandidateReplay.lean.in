set_option autoImplicit false
namespace TreeAccumulatorFixture
set_option genSizeOf false in inductive Tree (α : Type) where | leaf : α → Tree α | branch : Tree α → Tree α → Tree α
end TreeAccumulatorFixture
def TreeAccumulatorFixture.foldTree {α ρ : Type} (leaf : α → ρ) (branch : ρ → ρ → ρ) : TreeAccumulatorFixture.Tree α → ρ | .leaf x => leaf x | .branch l r => branch (TreeAccumulatorFixture.foldTree leaf branch l) (TreeAccumulatorFixture.foldTree leaf branch r)

def TreeAccumulatorReplay.candidate : {α σ : Type} → (σ → α → σ) → σ → TreeAccumulatorFixture.Tree α → σ :=
__EXACT_SYNTHESIZED_TERM__

theorem TreeAccumulatorReplay.candidate_passes :
(TreeAccumulatorReplay.candidate (fun (state value : Nat) => 10 * state + value) 7 (TreeAccumulatorFixture.Tree.leaf 2) = 72) ∧ (TreeAccumulatorReplay.candidate (fun (state value : Nat) => 10 * state + value) 0 (TreeAccumulatorFixture.Tree.branch (TreeAccumulatorFixture.Tree.leaf 1) (TreeAccumulatorFixture.Tree.leaf 2)) = 12) ∧ (TreeAccumulatorReplay.candidate (fun (state value : Nat) => 10 * state + value) 7 (TreeAccumulatorFixture.Tree.branch (TreeAccumulatorFixture.Tree.leaf 1) (TreeAccumulatorFixture.Tree.leaf 2)) = 712) ∧ (TreeAccumulatorReplay.candidate (fun (state value : Nat) => 10 * state + value) 37 (TreeAccumulatorFixture.Tree.branch (TreeAccumulatorFixture.Tree.leaf 1) (TreeAccumulatorFixture.Tree.leaf 2)) = 3712) ∧ (TreeAccumulatorReplay.candidate (fun (state value : Nat) => 10 * state + value) 7 (TreeAccumulatorFixture.Tree.branch (TreeAccumulatorFixture.Tree.branch (TreeAccumulatorFixture.Tree.leaf 1) (TreeAccumulatorFixture.Tree.leaf 2)) (TreeAccumulatorFixture.Tree.leaf 3)) = 7123) ∧ (TreeAccumulatorReplay.candidate (fun (state value : Nat) => 10 * state + value) 7 (TreeAccumulatorFixture.Tree.branch (TreeAccumulatorFixture.Tree.leaf 1) (TreeAccumulatorFixture.Tree.branch (TreeAccumulatorFixture.Tree.leaf 2) (TreeAccumulatorFixture.Tree.leaf 3))) = 7123) ∧ (TreeAccumulatorReplay.candidate (fun (state value : Nat) => 10 * state + value) 7 (TreeAccumulatorFixture.Tree.branch (TreeAccumulatorFixture.Tree.branch (TreeAccumulatorFixture.Tree.leaf 1) (TreeAccumulatorFixture.Tree.leaf 2)) (TreeAccumulatorFixture.Tree.branch (TreeAccumulatorFixture.Tree.leaf 3) (TreeAccumulatorFixture.Tree.leaf 4))) = 71234) ∧ (TreeAccumulatorReplay.candidate (fun (state value : Nat) => 10 * state + value) 7 (TreeAccumulatorFixture.Tree.branch (TreeAccumulatorFixture.Tree.leaf 1) (TreeAccumulatorFixture.Tree.branch (TreeAccumulatorFixture.Tree.branch (TreeAccumulatorFixture.Tree.leaf 2) (TreeAccumulatorFixture.Tree.leaf 3)) (TreeAccumulatorFixture.Tree.leaf 4))) = 71234) ∧ (TreeAccumulatorReplay.candidate (fun (state value : Nat) => 10 * state + value) 7 (TreeAccumulatorFixture.Tree.branch (TreeAccumulatorFixture.Tree.leaf 1) (TreeAccumulatorFixture.Tree.branch (TreeAccumulatorFixture.Tree.leaf 2) (TreeAccumulatorFixture.Tree.branch (TreeAccumulatorFixture.Tree.leaf 3) (TreeAccumulatorFixture.Tree.branch (TreeAccumulatorFixture.Tree.leaf 4) (TreeAccumulatorFixture.Tree.leaf 5))))) = 712345) ∧ (TreeAccumulatorReplay.candidate (fun (state value : Nat) => state * state + value) 2 (TreeAccumulatorFixture.Tree.branch (TreeAccumulatorFixture.Tree.leaf 1) (TreeAccumulatorFixture.Tree.branch (TreeAccumulatorFixture.Tree.leaf 2) (TreeAccumulatorFixture.Tree.leaf 3))) = 732) ∧ (TreeAccumulatorReplay.candidate (fun (state value : Nat) => state * state + value) 3 (TreeAccumulatorFixture.Tree.branch (TreeAccumulatorFixture.Tree.branch (TreeAccumulatorFixture.Tree.leaf 1) (TreeAccumulatorFixture.Tree.leaf 2)) (TreeAccumulatorFixture.Tree.leaf 3)) = 10407) ∧ (TreeAccumulatorReplay.candidate (fun (state : Nat) (value : Bool) => 2 * state + (if value then 1 else 0)) 3 (TreeAccumulatorFixture.Tree.branch (TreeAccumulatorFixture.Tree.leaf true) (TreeAccumulatorFixture.Tree.branch (TreeAccumulatorFixture.Tree.leaf false) (TreeAccumulatorFixture.Tree.leaf false))) = 28) ∧ (TreeAccumulatorReplay.candidate (fun (state : List Nat) (value : Nat) => state ++ [value]) [9, 8] (TreeAccumulatorFixture.Tree.branch (TreeAccumulatorFixture.Tree.leaf 1) (TreeAccumulatorFixture.Tree.branch (TreeAccumulatorFixture.Tree.leaf 2) (TreeAccumulatorFixture.Tree.leaf 3))) = [9, 8, 1, 2, 3]) ∧ (TreeAccumulatorReplay.candidate (fun (state : List Nat) (value : Nat) => state ++ [value]) [5] (TreeAccumulatorFixture.Tree.leaf 2) = [5, 2]) ∧ (TreeAccumulatorReplay.candidate (fun (state : Bool) (value : Nat) => if value == 1 then !state else false) true (TreeAccumulatorFixture.Tree.leaf 1) = false) ∧ (TreeAccumulatorReplay.candidate (fun (state : Bool) (value : Nat) => if value == 1 then !state else false) false (TreeAccumulatorFixture.Tree.leaf 1) = true) := by decide

